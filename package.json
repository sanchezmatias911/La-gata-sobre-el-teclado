{
  "scripts": {
    "bd:iniciar": "net start postgresql-x64-15",
    "matapuerto-8080": "powershell -Command \"Stop-Process -Id (Get-NetTCPConnection -LocalPort 8080).OwningProcess -Force\"",
    "appgym": "concurrently \"npm run dev --prefix frontend\" \"backend\\gradlew.bat -p backend bootRun\"",
    "install:frontend": "npm install --prefix frontend",
    "rebuild:backend": "backend\\gradlew.bat -p backend clean build -x test",
    "test:integracion": "cd backend && gradlew test --tests *GimnasioIntegracionTest"
  },
  "dependencies": {
    "react-toastify": "^11.1.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}